# ==========================================
# LineTTSBot Environment Variables
# ==========================================

# LINE authentication
# Phase 2で使用します。
LINE_EMAIL=
LINE_PASSWORD=

# 必要になった場合のみ使用
LINE_AUTH_TOKEN=

# アプリのルートを明示的に指定したい場合
# LINETTSBOT_ROOT=

# Node.js runtime
NODE_ENV=development