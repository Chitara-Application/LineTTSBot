{
  "name": "line-tts-bot",
  "version": "0.1.0",
  "private": true,
  "description": "LINE group-call TTS bot",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "main": "dist/gui/main.cjs" 
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@evex/linejs": "npm:@jsr/evex__linejs@^3.4.2",
    "dotenv": "^17.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.0.0",
    "wav-decoder": "^1.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "electron": "^44.4.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
